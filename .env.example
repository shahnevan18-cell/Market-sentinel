# Market Sentinel (India) configuration. Copy this file to .env and fill in what you need.
# Never commit .env: it can hold API keys. Every setting is optional.

# ---- Reasoning engine (optional) ----
# Leave everything blank to use the rule-based engine.
# Option A: Anthropic API (a claude.ai chat subscription does not include API access).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# claude-haiku-5-5 is cheaper; claude-opus-5-5 is stronger and slower.

# Option B: any OpenAI-compatible endpoint (Google Gemini, Groq, OpenRouter, OpenAI, a local Ollama server).
# Uncomment and fill in instead of Option A. Check the provider's current model list.
# gemini-3.5-flash completed a full investigation in testing on 20 Oct 2026; gemini-3.8-flash was slower.
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash

# Safety limits for the agent loop.
LLM_MAX_TOOL_CALLS=14
LLM_TIMEOUT=240
# Free tiers limit requests per minute. On HTTP 429 the app waits as long as the provider asks,
# at most this many seconds per wait and this many times, then falls back to the rule-based engine.
LLM_RATE_LIMIT_MAX_WAIT=65
LLM_RATE_LIMIT_RETRIES=2

# ---- Market data (NSE through Yahoo Finance) ----
# yfinance is the only provider in the India version (NSE symbols end in .NS; NIFTY 50 is ^NSEI).
MS_DATA_PROVIDER=yfinance
# Calendar days of history to request, and how long a download stays fresh.
MS_HISTORY_DAYS=760
MS_CACHE_TTL_HOURS=6
# Start the app in live or demo mode.
MS_DEFAULT_MODE=live

# ---- News ----
# Google News (India edition) and Yahoo Finance headlines. NSE/BSE announcements are link-only.
MS_NEWS_ENABLED=true
